# Local Vite development and preview proxy; this value is not bundled into the browser.
GATEWAY_PROXY_TARGET=http://localhost:8000

# Includes /api. Leave as /api when using the proxy or a same-origin deployment.
VITE_API_BASE_URL=/api

# The gateway waits for the complete workflow. A timeout does NOT cancel that workflow.
VITE_BOOKING_TIMEOUT_MS=300000

# Used to inspect an in-flight or disconnected booking before a response is available.
VITE_TEMPORAL_UI_URL=http://localhost:8233
VITE_TEMPORAL_NAMESPACE=layover
