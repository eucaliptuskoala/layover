**/__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
**/.venv/
.env
**/.env
**/.env.local
**/.env.*.local

# Testing & Tooling caches
.pytest_cache/
.ruff_cache/
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/
**/build/
**/dist/
.coverage
htmlcov/

# Local databases and journals
*.db
*.db-journal
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# Version control & OS
.git/
.github/
.DS_Store

# Documentation & Assets
docs/
ui/node_modules/
ui/dist/
ui_template/
